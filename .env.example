# Copy these names into Vercel (Project Settings > Environment Variables) and into .env.local for local testing.
# Put ONLY the value in Vercel, no quotes and no comments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never share this one or put NEXT_PUBLIC in front of it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server only. From console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key
# AI questions per user per day
DAILY_ASK_LIMIT=50
